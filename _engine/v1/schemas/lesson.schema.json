{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduitit.local/mathmon-engine-v1/lesson.schema.json",
  "title": "Mathmon Engine v1 Lesson Manifest",
  "type": "object",
  "required": [
    "engineVersion",
    "id",
    "folder",
    "modelName",
    "title",
    "shortTitle",
    "topic",
    "unitBadge",
    "goal",
    "buttonLabel",
    "rewardScreenTitle",
    "progressLabel",
    "rewardComplete",
    "tutorialTitle",
    "tutorialButton",
    "tutorialCards",
    "results",
    "rewardEvents",
    "wrongEvent",
    "typesPerRun",
    "tutorial",
    "reward",
    "result",
    "workbench",
    "stage",
    "standards",
    "imageAssets",
    "qa"
  ],
  "properties": {
    "engineVersion": { "const": "mathmon-engine-v1" },
    "id": { "type": "string", "pattern": "^3-2-[0-9]+-[0-9]+$" },
    "folder": { "type": "string", "pattern": "^3-2-[0-9]+-[0-9]+-mathmon-[a-z0-9-]+$" },
    "modelName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "title": { "type": "string", "minLength": 1 },
    "shortTitle": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "unitBadge": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "buttonLabel": { "type": "string", "minLength": 1 },
    "rewardScreenTitle": { "type": "string", "minLength": 1 },
    "progressLabel": { "type": "string", "minLength": 1 },
    "rewardComplete": { "type": "string", "minLength": 1 },
    "tutorialTitle": { "type": "string", "minLength": 1 },
    "tutorialButton": { "type": "string", "minLength": 1 },
    "tutorialCards": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          {
            "type": "object",
            "required": ["visual", "title", "body"],
            "properties": {
              "visual": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "minPower", "minCorrect", "image", "titleImage"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "minPower": { "type": "number", "minimum": 0, "maximum": 100 },
          "minCorrect": { "type": "number", "minimum": 0, "maximum": 10 },
          "needsSpecial": { "type": "boolean" },
          "image": { "type": "string", "pattern": "\\.webp$" },
          "titleImage": { "type": "string", "pattern": "\\.webp$" }
        },
        "additionalProperties": true
      }
    },
    "rewardEvents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "weight", "min", "max", "family"],
        "properties": {
          "weight": { "type": "number", "minimum": 1 },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "special": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "wrongEvent": {
      "type": "object",
      "required": ["id", "text", "min", "max", "family"],
      "additionalProperties": true
    },
    "typesPerRun": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "tutorial": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["card-grid", "poster-two-step"] }
      },
      "additionalProperties": true
    },
    "reward": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["stage-full", "modal-art", "inline-panel"] },
        "artMap": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["renderMode"],
      "properties": {
        "renderMode": { "enum": ["card-art", "simple-generated", "fullscene-score-slot", "hybrid-generated-dynamic"] }
      },
      "additionalProperties": true
    },
    "workbench": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "scoreboard": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "title": { "type": "string", "minLength": 1 },
        "titleArt": { "type": "string", "minLength": 1 },
        "resultKind": { "enum": ["score", "island", "rocket", "fusion"] },
        "scoreLabel": { "type": "string", "minLength": 1 },
        "listTitle": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "apiUrl": { "type": "string" }
      },
      "additionalProperties": true
    },
    "stage": {
      "type": "object",
      "required": ["ratio", "size"],
      "properties": {
        "ratio": { "const": "16:10" },
        "size": { "const": "1280x800" }
      }
    },
    "standards": {
      "type": "object",
      "required": ["cover", "coverStart", "settings", "resultVisual"],
      "properties": {
        "cover": { "const": "generated-title-overlay" },
        "coverStart": { "const": "generated-button-art" },
        "settings": { "const": "modal-controls" },
        "resultVisual": { "const": "generated-assets" }
      }
    },
    "imageAssets": {
      "type": "object",
      "required": ["cover", "titleArt", "startButton", "rewardScene", "resultRetryButton"],
      "additionalProperties": { "type": "string" }
    },
    "assets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "qa": {
      "type": "object",
      "required": ["viewports", "requiredFlow"],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "width", "height"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "width": { "type": "number", "minimum": 1 },
              "height": { "type": "number", "minimum": 1 }
            }
          }
        },
        "requiredFlow": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": true
}
