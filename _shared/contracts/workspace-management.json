  },
  "storageGuard": {
    "warningFreeGiB": 80,
    "blockFreeGiB": 50,
    "canonicalWarningGiB": 35,
    "gitWarningGiB": 8,
    "worktreeWarningGiB": 3,
    "exemptOperations": [
      "status",
      "doctor",
      "cleanup",
      "finish"
    ]
  },
  "sparseCheckout": {
    "enabledByDefault": true,
