  "evidenceCache": {
    "standard": "ai-mart-ephemeral-browser-evidence-v1",
    "scope": "lesson screenshots directories containing QA capture PNG files",
    "gitTracking": "forbidden",
    "localRetention": "until-validation-or-publication-completes",
