  "qa": {
    "viewports": [
      { "name": "desktop-1280x800", "width": 1280, "height": 800 },
      { "name": "tablet-landscape-1024x768", "width": 1024, "height": 768 },
      { "name": "feedback-reported-1079x929", "width": 1079, "height": 929 },
      { "name": "feedback-reported-1079x842", "width": 1079, "height": 842 }
    ],
    "requiredScreens": ["cover", "tutorial", "play", "result"],
    "requiredFlowStates": ["answering", "feedback-correct", "feedback-wrong", "trace-stamped", "trace-silhouette", "trace-trait"],
    "requiredOverlays": ["settings", "trace-reveal"],
    "coverCopyAudit": {
      "standard": "socialmon-generated-cover-copy-v1",
      "art": "#coverCopyArt",
      "hiddenText": ["#coverTitle", "#coverGoal", ".series-kicker"],
      "sourceRequired": true
    },
    "tutorialPosterAudit": {
      "standard": "socialmon-generated-tutorial-poster-v1",
      "poster": "#tutorialPosterArt",
      "hitbox": "#tutorialStartButton",
      "canvas": "1280x800",
      "hitboxRect": {
        "leftRatio": 0.3375,
        "topRatio": 0.845,
        "widthRatio": 0.339,
        "heightRatio": 0.132
      },
      "maxEdgeErrorPx": 1
    },
    "brandMarkAudit": {
      "standard": "socialmon-purple-cloud-mark-v1",
      "selector": ".socialmon-brand-mark",
      "assetSuffix": "_shared/brand/mathmon-cloud-mark.webp"
    },
    "playDiscoveryAudit": {
      "standard": "socialmon-left-reveal-progress-v1",
      "panel": "#discoveryPanel",
      "workArea": "#playWorkArea",
      "expectedWidthRatio": 0.245,
      "minWorkGapRatio": 0.015625,
      "tolerancePx": 1,
      "traceStates": [0, 1, 2, 3, 4, 5, 6],
      "visibleProgress": "#questionProgress",
      "hiddenProgress": "#traceProgress"
    },
    "sourceChoiceAudit": {
      "standard": "socialmon-source-choice-tablet-v3",
      "sourceCard": ".source-card.has-image",
      "sourceImage": ".source-image",
      "choice": ".choice-option",
      "minSourceImageWidthRatio": 0.22,
      "minSourcePixelDensity": 3,
      "minPromptFontPx": 34,
      "minSourceTitleFontPx": 24,
      "minSourceBodyFontPx": 20,
      "sourceCredit": "#playSourceCredit",
      "maxSourceCreditFontPx": 12,
      "requireSourceCreditBackplate": true,
      "maxSourceCreditRightInsetRatio": 0.03,
      "maxSourceCreditBottomInsetRatio": 0.03,
      "minChoiceHeightPx": 94,
      "minChoiceFontPx": 21,
      "maxChoiceWidthRatio": 0.31,
      "minOptionImageNaturalWidth": 512,
      "minSubmitWidthPx": 150,
      "minSubmitHeightPx": 52,
      "minSubmitSafeInsetPx": 4,
      "minSourceChoiceGapRatio": 0.01,
      "maxCoreVerticalGapRatio": 0.04,
      "maxAdjacentGapRatio": 2,
      "maxCorrectChoiceTokenOverlapRatio": 0.6,
      "minCorrectChoiceTokenMatches": 2,
      "requireSourceImage": true,
      "requireAllOptionImages": true,
      "forbidAnswerLeak": true,
      "forbidCenteredWorkbench": true,
      "hideQuestionKind": true,
      "hideImageSourceInstruction": true,
      "hideInlineSourceCredit": true
    },
    "illustratedOptionAudit": {
      "standard": "socialmon-stacked-option-art-v1",
      "minImageWidthRatio": 0.72,
      "minImageHeightRatio": 0.36,
      "minImageBoxHeightPx": 64,
      "minBoardFillRatio": 0.82,
      "maxEmptyBandRatio": 0.04,
      "maxImageLabelOverlapPx": 2,
      "maxSourceAccentBorderExtraPx": 1,
      "fillQuestionTypes": ["choice", "match"]
    },
    "mapHotspotAudit": {
      "standard": "socialmon-source-choice-map-hotspots-v1",
      "board": ".map-hotspot-board",
      "mapImage": ".map-hotspot-image",
      "target": ".map-hotspot-target",
      "minMapWidthRatio": 0.42,
      "minMapPixelDensity": 3,
      "minTargetSizePx": 42,
      "minSafeInsetPx": 4,
      "requiredTargetCount": 4,
      "maxTargetOverlapPx": 0
    },
    "forbidTextOverflow": true,
    "forbidSiblingOverlap": true,
    "requireSourceEvidence": true,
    "forbidGeneratedFactualEvidence": true
  }
